{
  "info": {
    "name": "PUT API - Schema Validation and Assertions",
    "description": "Practice collection for PUT API response schema validation and assertions using JSONPlaceholder",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://jsonplaceholder.typicode.com"
    }
  ],
  "item": [
    {
      "name": "TC01 - PUT Response Schema Validation",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"title\": \"Updated API Title\",\n  \"body\": \"Updated API Body\",\n  \"userId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/posts/1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is JSON', function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "pm.test('Response time is below 2000ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "const res = pm.response.json();",
              "",
              "pm.test('Response contains id', function () {",
              "    pm.expect(res).to.have.property('id');",
              "});",
              "",
              "pm.test('Response contains title', function () {",
              "    pm.expect(res).to.have.property('title');",
              "});",
              "",
              "pm.test('Response contains body', function () {",
              "    pm.expect(res).to.have.property('body');",
              "});",
              "",
              "pm.test('Response contains userId', function () {",
              "    pm.expect(res).to.have.property('userId');",
              "});",
              "",
              "pm.test('Title value is updated correctly', function () {",
              "    pm.expect(res.title).to.eql('Updated API Title');",
              "});",
              "",
              "pm.test('Body value is updated correctly', function () {",
              "    pm.expect(res.body).to.eql('Updated API Body');",
              "});",
              "",
              "pm.test('UserId value is correct', function () {",
              "    pm.expect(res.userId).to.eql(1);",
              "});",
              "",
              "const schema = {",
              "    type: 'object',",
              "    required: ['id', 'title', 'body', 'userId'],",
              "    properties: {",
              "        id: { type: 'number' },",
              "        title: { type: 'string' },",
              "        body: { type: 'string' },",
              "        userId: { type: 'number' }",
              "    }",
              "};",
              "",
              "pm.test('JSON Schema Validation Passed', function () {",
              "    pm.response.to.have.jsonSchema(schema);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "TC02 - Validate Required Response Fields",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"title\": \"Schema Test\",\n  \"body\": \"Testing Required Fields\",\n  \"userId\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/posts/1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const res = pm.response.json();",
              "",
              "pm.test('All required fields are present', function () {",
              "    pm.expect(res).to.have.all.keys('id', 'title', 'body', 'userId');",
              "});",
              "",
              "pm.test('Title is not empty', function () {",
              "    pm.expect(res.title).to.not.eql('');",
              "});",
              "",
              "pm.test('Body is not empty', function () {",
              "    pm.expect(res.body).to.not.eql('');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "TC03 - Validate Response Data Types",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"title\": \"Datatype Validation\",\n  \"body\": \"Validate response datatypes\",\n  \"userId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/posts/1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const res = pm.response.json();",
              "",
              "pm.test('ID datatype is number', function () {",
              "    pm.expect(res.id).to.be.a('number');",
              "});",
              "",
              "pm.test('Title datatype is string', function () {",
              "    pm.expect(res.title).to.be.a('string');",
              "});",
              "",
              "pm.test('Body datatype is string', function () {",
              "    pm.expect(res.body).to.be.a('string');",
              "});",
              "",
              "pm.test('UserId datatype is number', function () {",
              "    pm.expect(res.userId).to.be.a('number');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "TC04 - Validate PUT Updated Values",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"title\": \"New Updated Title\",\n  \"body\": \"New Updated Body\",\n  \"userId\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/posts/1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
